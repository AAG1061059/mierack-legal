<title>特定商取引法に基づく表記 — みえらっく</title>
<style>
  :root {
    color-scheme: light dark;
    --bg: #f2f2f7;
    --card: #ffffff;
    --text: #111114;
    --muted: rgba(60,60,67,0.62);
    --line: rgba(60,60,67,0.16);
    --accent: #1f6fc5;
    --accent-soft: rgba(31,111,197,0.10);
  }
  :root:not([data-theme="light"]) {
    @media (prefers-color-scheme: dark) {
      --bg: #000000;
      --card: #1c1c1e;
      --text: #f5f5f7;
      --muted: rgba(235,235,245,0.62);
      --line: rgba(235,235,245,0.18);
      --accent: #6fa8e6;
      --accent-soft: rgba(75,180,240,0.14);
    }
  }
  :root[data-theme="dark"] {
    --bg: #000000;
    --card: #1c1c1e;
    --text: #f5f5f7;
    --muted: rgba(235,235,245,0.62);
    --line: rgba(235,235,245,0.18);
    --accent: #6fa8e6;
    --accent-soft: rgba(75,180,240,0.14);
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Hiragino Sans", "Noto Sans JP", "Segoe UI", system-ui, sans-serif;
    line-height: 1.8;
    -webkit-font-smoothing: antialiased;
  }

  .wrap { max-width: 720px; margin: 0 auto; padding: 0 20px 80px; }

  header {
    padding: 56px 0 36px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 36px;
  }
  .badge {
    display: inline-block;
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
    background: var(--accent-soft);
    padding: 6px 12px;
    border-radius: 20px;
    margin-bottom: 16px;
  }
  h1 { font-size: 30px; font-weight: 700; margin: 0 0 8px; letter-spacing: -0.5px; }
  .sub { color: var(--muted); font-size: 15px; margin: 0; }

  .lead {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 22px 24px;
    margin-bottom: 40px;
  }
  .lead p { margin: 0; font-size: 15px; }
  .lead strong { color: var(--accent); }

  section { margin-bottom: 38px; }
  h2 {
    font-size: 19px;
    font-weight: 700;
    margin: 0 0 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--line);
    letter-spacing: -0.2px;
  }
  p { font-size: 15px; margin: 0 0 14px; }
  ul { margin: 0 0 14px; padding-left: 22px; }
  li { font-size: 15px; margin-bottom: 8px; }

  .note {
    font-size: 14px;
    color: var(--muted);
    background: var(--card);
    border-left: 3px solid var(--accent);
    border-radius: 0 10px 10px 0;
    padding: 14px 18px;
    margin: 18px 0;
  }

  table { width: 100%; border-collapse: collapse; margin: 6px 0 16px; font-size: 14px; }
  th, td { text-align: left; padding: 11px 12px; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { color: var(--muted); font-weight: 600; width: 38%; }

  .fill { color: var(--accent); font-weight: 600; }

  footer {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 13px;
  }
  footer p { font-size: 13px; }

  .en {
    margin-top: 44px;
    padding: 24px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 16px;
  }
  .en h2 { font-size: 17px; }
  .en p, .en li { font-size: 14px; }

  @media (max-width: 480px) {
    header { padding: 40px 0 28px; }
    h1 { font-size: 25px; }
    th { width: 42%; }
  }

  .fill { background: #fff3a8; color: #6b4e00; padding: 0 4px; border-radius: 4px; font-weight: 600; }
  table.info { width: 100%; border-collapse: collapse; font-size: 14px; margin: 8px 0; }
  table.info th, table.info td { text-align: left; padding: 8px 6px; border-bottom: 1px solid var(--line); vertical-align: top; }
  table.info th { color: var(--muted); font-weight: 600; width: 34%; }
</style>
</head>
